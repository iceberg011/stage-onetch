    // ===== EDIT USER (GET) =====
@GetMapping("/dashboard/users/edit/{id}")
public String editUser(
        @PathVariable Long id,
        HttpSession session,
        Model model) {
    
    System.out.println("=== GET /dashboard/users/edit/" + id + " called ===");
    
    qsd currentUser = (qsd) session.getAttribute("user");
    
    if (currentUser == null) {
        return "redirect:/signin";
    }
    
    // Find user by ID
    Optional<qsd> userOpt = userRepository.findById(id);
    
    if (userOpt.isEmpty()) {
        System.out.println("User not found with ID: " + id);
        return "redirect:/dashboard/Users?error=UserNotFound";
    }
    
    qsd userToEdit = userOpt.get();
    
    // Get all departments
    List<departments> departments = departmentRepository.findAll();
    model.addAttribute("departments", departments);
    
    // Get user's current department IDs from the link table
    List<link> userLinks = linkRepository.findByMyuser_id(Math.toIntExact(id));
    List<Integer> userDepartmentIds = userLinks.stream()
            .map(link::getdepartment_id)
            .collect(Collectors.toList());
    model.addAttribute("userDepartments", userDepartmentIds);
    
    // ===== DEBUG: Show user's current department in terminal =====
    System.out.println("\n--- USER DEPARTMENT INFO ---");
    System.out.println("User: " + userToEdit.getUsername() + " (ID: " + userToEdit.getId() + ")");
    if (userDepartmentIds.isEmpty()) {
        System.out.println("Currently assigned to: No Department");
    } else {
        for (Integer deptId : userDepartmentIds) {
            Optional<departments> deptOpt = departmentRepository.findById(deptId.longValue());
            if (deptOpt.isPresent()) {
                departments dept = deptOpt.get();
                System.out.println("Currently assigned to: " + dept.getdept_name() + " (ID: " + deptId + ")");
            }
        }
    }
    System.out.println("==============================\n");
    
    model.addAttribute("user", userToEdit);
    model.addAttribute("pageTitle", "Edit User");
    model.addAttribute("pageContent", "User/EditUser");
    model.addAttribute("firstName", currentUser.getFirst_name());
    model.addAttribute("lastName", currentUser.getLast_name());
    model.addAttribute("email", currentUser.getEmail());
    model.addAttribute("username", currentUser.getUsername());
    
    return "Components/layout";
}

// ===== UPDATE USER =====
@PostMapping("/dashboard/users/update/{id}")
public String updateUser(
        @PathVariable Long id,
        @RequestParam("first_name") String firstName,
        @RequestParam("last_name") String lastName,
        @RequestParam("email") String email,
        @RequestParam(value = "tele_phone", required = false) String telePhone,
        @RequestParam("username") String username,
        @RequestParam(value = "password", required = false) String password,
        @RequestParam(value = "confirm_password", required = false) String confirmPassword,
        @RequestParam(value = "role", defaultValue = "user") String role,
        @RequestParam(value = "is_active", defaultValue = "true") String isActive,
        @RequestParam(value = "is_staff", defaultValue = "false") boolean isStaff,
        @RequestParam(value = "is_superuser", defaultValue = "false") boolean isSuperuser,
        @RequestParam(value = "is_public", defaultValue = "false") boolean isPublic,
        @RequestParam(value = "can_manage_all_dept", defaultValue = "false") boolean canManageAllDept,
        @RequestParam(value = "department_id", required = false) Integer departmentId,
        HttpSession session,
        Model model) {

    System.out.println("\n=== POST /dashboard/users/update/" + id + " called ===");
    System.out.println("Department ID received: " + departmentId);
    
    qsd currentUser = (qsd) session.getAttribute("user");
    
    if (currentUser == null) {
        return "redirect:/signin";
    }
    
    // Find user by ID
    Optional<qsd> userOpt = userRepository.findById(id);
    
    if (userOpt.isEmpty()) {
        System.out.println("User not found with ID: " + id);
        return "redirect:/dashboard/Users?error=UserNotFound";
    }
    
    qsd userToUpdate = userOpt.get();
    System.out.println("Updating user: " + userToUpdate.getUsername());
    
    // Check if password is being changed
    if (password != null && !password.isEmpty()) {
        if (!password.equals(confirmPassword)) {
            model.addAttribute("error", "Passwords do not match");
            model.addAttribute("user", userToUpdate);
            model.addAttribute("pageTitle", "Edit User");
            model.addAttribute("pageContent", "User/EditUser");
            // Load departments for the form again
            model.addAttribute("departments", departmentRepository.findAll());
            List<link> userLinks = linkRepository.findByMyuser_id(Math.toIntExact(id));
            List<Integer> userDepartmentIds = userLinks.stream()
                    .map(link::getdepartment_id)
                    .collect(Collectors.toList());
            model.addAttribute("userDepartments", userDepartmentIds);
            model.addAttribute("firstName", currentUser.getFirst_name());
            model.addAttribute("lastName", currentUser.getLast_name());
            model.addAttribute("email", currentUser.getEmail());
            model.addAttribute("username", currentUser.getUsername());
            return "Components/layout";
        }
        // Set new password (will be encrypted in service)
        userToUpdate.setPassword(password);
        System.out.println("Password updated for user: " + userToUpdate.getUsername());
    }
    
    // Update user fields
    userToUpdate.setFirst_name(firstName);
    userToUpdate.setLast_name(lastName);
    userToUpdate.setEmail(email);
    userToUpdate.setUsername(username);
    userToUpdate.setIs_active("true".equalsIgnoreCase(isActive));
    userToUpdate.setIs_staff(isStaff);
    userToUpdate.setIs_superuser(isSuperuser);
    userToUpdate.setIs_public(isPublic);
    userToUpdate.setCan_manage_all_dept(canManageAllDept);
    userToUpdate.setUpdate_time(LocalDateTime.now());
    
    // Update phone number
    if (telePhone != null && !telePhone.isEmpty()) {
        try {
            userToUpdate.settele_phone(Integer.parseInt(telePhone));
        } catch (NumberFormatException e) {
            userToUpdate.settele_phone(null);
        }
    } else {
        userToUpdate.settele_phone(null);
    }
    
    try {
        // ===== HANDLE DEPARTMENT ASSIGNMENT IN LINK TABLE =====
        System.out.println("\n--- DEPARTMENT ASSIGNMENT ---");
        
        // First, delete all existing department links for this user
        linkRepository.deleteByMyuser_id(Math.toIntExact(id));
        System.out.println("Deleted existing department links for user ID: " + id);
        
        // If a department is selected, create a new link
        if (departmentId != null && departmentId > 0) {
            // Verify the department exists
            Optional<departments> deptOpt = departmentRepository.findById(departmentId.longValue());
            if (deptOpt.isPresent()) {
                departments department = deptOpt.get();
                
                // Create new link entry - SAVE USER ID AND DEPARTMENT ID IN LINK TABLE
                link newLink = new link();
                newLink.setmyuser_id(Math.toIntExact(id));  // User ID
                newLink.setdepartment_id(departmentId);      // Department ID
                linkRepository.save(newLink);
                
                System.out.println("✅ LINK SAVED TO auth_user_auth_dept:");
                System.out.println("   User ID: " + id + " (User: " + userToUpdate.getUsername() + ")");
                System.out.println("   Department ID: " + departmentId + " (Department: " + department.getdept_name() + ")");
                System.out.println("   User " + userToUpdate.getUsername() + " assigned to department: " + department.getdept_name());
            } else {
                System.out.println("❌ Department not found with ID: " + departmentId);
            }
        } else {
            System.out.println("ℹ️ No department selected - user will have no department assigned");
            System.out.println("   User " + userToUpdate.getUsername() + " has no department assigned");
        }
        System.out.println("============================\n");
        
        // Save user
        userService.saveUser(userToUpdate);
        System.out.println("✅ User updated successfully: " + userToUpdate.getUsername());
        
        return "redirect:/dashboard/Users?success=UserUpdated";
        
    } catch (Exception e) {
        System.err.println("❌ Error updating user: " + e.getMessage());
        e.printStackTrace();
        
        model.addAttribute("error", "Error updating user: " + e.getMessage());
        model.addAttribute("user", userToUpdate);
        model.addAttribute("pageTitle", "Edit User");
        model.addAttribute("pageContent", "User/EditUser");
        // Load departments for the form again
        model.addAttribute("departments", departmentRepository.findAll());
        List<link> userLinks = linkRepository.findByMyuser_id(Math.toIntExact(id));
        List<Integer> userDepartmentIds = userLinks.stream()
                .map(link::getdepartment_id)
                .collect(Collectors.toList());
        model.addAttribute("userDepartments", userDepartmentIds);
        model.addAttribute("firstName", currentUser.getFirst_name());
        model.addAttribute("lastName", currentUser.getLast_name());
        model.addAttribute("email", currentUser.getEmail());
        model.addAttribute("username", currentUser.getUsername());
        return "Components/layout";
    }
}
















    
    // ===== DELETE USER =====
    @GetMapping("/dashboard/users/delete/{id}")
    public String deleteUser(@PathVariable Long id, HttpSession session) {
        System.out.println("=== GET /dashboard/users/delete/" + id + " called ===");
        
        qsd currentUser = (qsd) session.getAttribute("user");
        
        if (currentUser == null) {
            return "redirect:/signin";
        }
        
        // Don't allow deleting yourself
        if (currentUser.getId().equals(id)) {
            return "redirect:/dashboard/Users?error=CannotDeleteSelf";
        }
        
        Optional<qsd> userOpt = userRepository.findById(id);
        
        if (userOpt.isPresent()) {
            userRepository.deleteById(id);
            System.out.println("User deleted with ID: " + id);
            return "redirect:/dashboard/Users?success=UserDeleted";
        }
        
        return "redirect:/dashboard/Users?error=UserNotFound";
    }

